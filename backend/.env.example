# General Settings
APP_DEBUG_MODE=false
APP_LOG_LEVEL=INFO
APP_GO_SERVER_PATH=../mcp-server/mcp-server

# LLM Settings
APP_LLM__API_KEY=your_dashscope_api_key_here
APP_LLM__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
APP_LLM__MODEL_NAME=qwen-max
APP_LLM__TEMPERATURE=0.7
APP_LLM__CONTEXT_WINDOW=4096

# Database Settings
APP_DB__USER=root
APP_DB__PASSWORD=k8s_insight_secret
APP_DB__HOST=localhost
APP_DB__PORT=3306
APP_DB__DB_NAME=k8s_insight
